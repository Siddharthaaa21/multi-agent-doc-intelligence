# LLM API Keys (Optional - The orchestrator defaults to built-in simulation mode if omitted)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Provider selection: "simulation" | "openai" | "anthropic"
LLM_PROVIDER=simulation

# Models
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Guardrail & Orchestration Parameters
GUARDRAIL_CONFIDENCE_THRESHOLD=0.95
MAX_REFINEMENT_LOOPS=2
PORT=8000
